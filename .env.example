# 运行环境（必填）
# 可选值：development | production | test
NODE_ENV=development

# API 根路由前缀（必填）
# 示例：/api
API_PREFIX=/api

# 服务监听端口（必填）
PORT=3000

# OpenAPI JSON 接口路径（必填）
OPENAPI_URL=/openapi/json

# PostgreSQL 连接地址
# 示例：postgresql://user:password@127.0.0.1:5432/yuumi
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/yuumi

# Drizzle 方言（可选）
# 可选值：postgresql | mysql | sqlite
# 默认：postgresql
#DIALECT=postgresql

# JWT（HS256）签名密钥
JWT_SECRET=replace-with-a-strong-secret

# 自动日志位图（可选）
# 默认规则：开发环境默认 LogMasks.DEV_DEFAULT，生产环境默认 LogMasks.PROD_DEFAULT
# 可按需组合 LogBits（包含 LogBits.WRITE_FILE）
# 示例：731（等价 LogMasks.INFO）
#LOG_MASK=731

# 文件日志目录（可选）
# - 不配置：不写文件日志
# - 相对路径：相对 server 根目录解析
# - 默认建议：logs（即 server 根目录下的 logs）
LOG_FILE_DIR=logs

# 文件日志保留天数（可选，正整数）
# - 不配置：不自动清理历史日志
#LOG_FILE_RETENTION_DAYS=14

# 单日志文件最大大小（字节，可选，正整数）
# - 不配置：默认 102400（100KB）并自动切分到同日下一个文件
#LOG_FILE_MAX_BYTES=10485760

# 幂等缓存 TTL（毫秒，可选）
IDEMPOTENCY_TTL_MS=86400000
