# 运行环境（必填）
# 可选值：development | production | test
APP_ENV=development

# 服务监听端口（必填）
PORT=3000

# OpenAPI JSON 接口路径（必填）
OPENAPI_URL=/openapi/json

# PostgreSQL 连接地址
# 示例：postgresql://user:password@127.0.0.1:5432/yuumi
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/yuumi

# JWT（HS256）签名密钥
JWT_SECRET=replace-with-a-strong-secret

# 日志级别（可选）
# 可选值：trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# OpenTelemetry 开关（必填）
# 可选值：0 | 1
OTEL_ENABLED=0

# 幂等缓存 TTL（毫秒，可选）
IDEMPOTENCY_TTL_MS=86400000
