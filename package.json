{
  "name": "@yuumi/server",
  "version": "1.0.50",
  "module": "src/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun --watch --env-file=env --env-file=env.development --env-file=env.development.local src/index.ts",
    "start:dev": "bun --env-file=env --env-file=env.development --env-file=env.development.local src/index.ts",
    "start:test": "bun --env-file=env --env-file=env.test --env-file=env.test.local src/index.ts",
    "start:prod": "bun --env-file=env --env-file=env.production --env-file=env.production.local src/index.ts",
    "docs:response-codes": "bun scripts/generateResponseCodeDoc.ts",
    "db:introspect": "bun --bun drizzle-kit introspect",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:push": "bun --bun drizzle-kit push"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@casl/ability": "^6.8.0",
    "@elysiajs/bearer": "^1.4.2",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.12",
    "@elysiajs/server-timing": "^1.4.0",
    "@node-idempotency/core": "^1.0.11",
    "@node-idempotency/storage-adapter-memory": "^1.0.5",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^1.0.0-beta.20",
    "elysia": "latest",
    "http-errors": "^2.0.1",
    "pg": "^8.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/http-errors": "^2.0.5",
    "@antfu/eslint-config": "^6.7.3",
    "bun-types": "latest",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.1.0",
    "jiti": "^2.6.1"
  }
}
